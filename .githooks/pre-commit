#!/bin/sh
# Portable entry to the existing fast pre-commit configuration.
# Runtime Python follows the active environment; no installation path is pinned.
if command -v python >/dev/null 2>&1; then
  exec python -m pre_commit hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit --hook-dir "$(dirname "$0")" -- "$@"
elif command -v python3 >/dev/null 2>&1; then
  exec python3 -m pre_commit hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit --hook-dir "$(dirname "$0")" -- "$@"
elif command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit --hook-dir "$(dirname "$0")" -- "$@"
fi
printf '%s\n' 'pre-commit unavailable; activate the configured Python environment.' >&2
exit 1
