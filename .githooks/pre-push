#!/bin/sh
# Daily pushes run Ruff once plus a fixed small pure-unit smoke.
# Complete CI/manual checks remain explicit; local_fast_pass is smoke only.
#
# Installed as .githooks/pre-push (git config core.hooksPath .githooks).
# No type/config/plan/install or full CI suite is repeated on daily push.
#
# NOTE: shebang MUST be #!/bin/sh (git-for-windows spawns /bin/sh hooks
# natively; /usr/bin/env bash failed with "cannot spawn").  Use
# `python`, not python3, on Windows.

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ ! -f "$ROOT/tools/pre_push_gate.py" ]; then
  echo "pre-push gate: tools/pre_push_gate.py missing - cannot run push checks" >&2
  exit 1
fi

python "$ROOT/tools/pre_push_gate.py" --push-checks
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "PUSH BLOCKED by pre-push gate (CI root-fix protocol). Fix the root cause; do not bypass." >&2
fi
exit "$rc"
