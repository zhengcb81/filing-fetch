#!/bin/sh
# Fast static checks plus the same focused regression runner used by CI.
# Run the full hermetic suite manually for broad changes.
#
# Installed as .githooks/pre-push (git config core.hooksPath .githooks).
# Every `git push` runs static/config and focused behavior checks before CI.
#
# NOTE: shebang MUST be #!/bin/sh (git-for-windows spawns /bin/sh hooks
# natively; /usr/bin/env bash failed with "cannot spawn").  Use
# `python`, not python3, on Windows.

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ ! -f "$ROOT/tools/pre_push_gate.py" ]; then
  echo "pre-push gate: tools/pre_push_gate.py missing - skipping" >&2
  exit 0
fi

python "$ROOT/tools/pre_push_gate.py" --skip-install-sync --ci-tests
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "PUSH BLOCKED by pre-push gate (CI root-fix protocol). Fix the root cause; do not bypass." >&2
fi
exit "$rc"
